    },
    {
      "id": "executable-requirements",
      "version": "60822.1"
    },
    {
      "id": "flutter",
      "version": "60822.1"
    },
    {
      "id": "android",
      "version": "60822.1"
    },
    {
      "id": "ios",
      "version": "60822.1"
    },
    {
      "id": "firebase",
      "version": "60822.1"
    },
    {
      "id": "node",
      "version": "60823.1",
      "config": {
        "dirs": [
          "firebase/functions"
        ]
      }
    },
    {
      "id": "basics",
      "version": "60823.1"
    },
    {
      "id": "barriers",
      "version": "60823.1",
      "via": [
        "basics"
      ]
    },
    {
      "id": "tidy-repo",
      "version": "60823.1"
    },
    {
      "id": "claudinite-growth",
      "version": "60823.2"
    },
    "local/shouts-and-whispers",
    {
      "id": "claude-code-web-users-support",
      "version": "60823.1",
      "config": {
        "repo": "missingbulb/Shepherd"
      }
    },
    {
      "id": "claudinite-lifecycle",
      "version": "60823.1"
    }
  ],
  "accept": [
    {
      "rule": "pack-declaration",
      "path": ".claudinite-checks.json",
      "reason": "node genuinely applies but its package.json lives at firebase/functions/package.json — two directories down, past the node pack's intentional near-root fingerprint cap (root or one dir down) that keeps nested fixtures from tripping detection. So the declaration is deliberately ahead of the fingerprint here. Every other declared pack fingerprint-matches without acceptance: flutter (app/pubspec.yaml), firebase (firebase/firebase.json, one dir down — now detected since Claudinite PR #190), android (app/android/.../AndroidManifest.xml), ios (app/ios/Runner/Info.plist), executable-requirements (dev/requirements/requirements.md)."
    }
  ],
  "taskScheduler": {
    "agenticTaskInvocationEndpoints": {
      "default": {
        "url": "https://api.anthropic.com/v1/claude_code/routines/trig_01VoSm2pim6PjfD6aBuh3Ahe/fire",
        "tokenSecret": "CCR_ROUTINE_TOKEN"
      }
    },
    "dailyHour": 4,
    "weeklyDay": "Sun",
    "monthlyDay": 1
  },
  "engineVersion": "60823.1"
}
